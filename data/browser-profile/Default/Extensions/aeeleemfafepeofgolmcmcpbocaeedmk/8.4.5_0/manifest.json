{
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "content_security_policy": {
      "extension_page": "script-src 'self'  https://*.facebook.com  https://*.google.com  https://ssl.google-analytics.com https://*.wips.com https://*.facebook.net https://*.twitter.com https://*.doubleclick.net; object-src 'self'"
   },
   "description": "",
   "host_permissions": [ "http://*/", "https://*/", "\u003Call_urls>" ],
   "icons": {
      "128": "icon.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "GRADIUS DLP MV3",
   "permissions": [ "nativeMessaging", "tabs", "management", "webRequest", "webRequestBlocking", "webNavigation", "unlimitedStorage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "8.4.5",
   "web_accessible_resources": [ {
      "matches": [ "*://*/*" ],
      "resources": [ "blocked.html" ]
   } ]
}
