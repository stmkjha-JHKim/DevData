<script>
  // Applied as early as possible (before <style> below is even parsed) so a
  // saved preference takes effect from the very first paint instead of
  // flashing one theme then the other. See the Theme switcher note further
  // down for the matching <select> wiring and localStorage persistence.
  // Default (nothing saved yet, i.e. first-ever launch) is light -- only an
  // explicit saved "dark" switches it back.
  (function () {
    try {
      var saved = localStorage.getItem('orapulseTheme');
      document.documentElement.setAttribute('data-theme', saved === 'dark' ? 'dark' : 'light');
    } catch (_) {
      // localStorage can throw in some restricted browser contexts -- default to light.
      document.documentElement.setAttribute('data-theme', 'light');
    }
  })();
</script>
